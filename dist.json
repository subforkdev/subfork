{
    "author": "ryan@rsg.io",
    "targets": {
        "bin": {
            "source": "build/bin/*",
            "destination": "{DEPLOY_ROOT}/bin/%1",
            "options": {"match": "content"}
        },
        "build": {
            "source": "build/*",
            "destination": "{DEPLOY_ROOT}/lib/python/%1",
            "options": {"match": "content"}
        },
        "config": {
            "source": "subfork.yml",
            "destination": "{DEPLOY_ROOT}/subfork.yml"
        },
        "services": {
            "source": "services",
            "destination": "{DEPLOY_ROOT}/services/subfork",
            "pipeline": {
                "replace_tokens": {
                    "func": "distman.transform.replace_tokens",
                    "options": {
                        "tokens": {
                            "__DEPLOY_ROOT__": "{DEPLOY_ROOT}" 
                        }
                    }
                }
            }
        },
        "env": {
            "source": "subfork.env",
            "destination": "{DEPLOY_ROOT}/env/subfork.env"
        },
        "subfork": {
            "source": "bin/*",
            "destination": "{DEPLOY_ROOT}/bin/%1",
            "options": {"match": "content"}
        },
        "lib": {
            "source": "lib/subfork",
            "destination": "{DEPLOY_ROOT}/lib/python/subfork"
        }
    }
}