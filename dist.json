{
    "author": "ryan@rsg.io",
    "targets": {
        "env": {
            "source": "subfork.env",
            "destination": "{DEPLOY_ROOT}/env/subfork.env"
        },
        "lib": {
            "source": "lib/subfork",
            "destination": "{DEPLOY_ROOT}/lib/python/subfork"
        },
        "bin": {
            "source": "bin/*",
            "destination": "{DEPLOY_ROOT}/bin/%1",
            "options": {"match": "content"}
        },
        "build-lib": {
            "source": "build/*",
            "destination": "{DEPLOY_ROOT}/lib/python/%1",
            "options": {"match": "content"}
        },
        "build-bin": {
            "source": "build/bin/*",
            "destination": "{DEPLOY_ROOT}/bin/%1",
            "options": {"match": "content"}
        }
    }
}