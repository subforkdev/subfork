#!/usr/bin/env envstack
include: []
all: &all
  SUBFORK_DEBUG: false
  # SUBFORK_DOMAIN: test.fork.io
  SUBFORK_ACCESS_KEY: ${SUBFORK_ACCESS_KEY:=XXXXXXXXXXXXXXXX}
  SUBFORK_SECRET_KEY: ${SUBFORK_SECRET_KEY:=XXXXXXXXXXXXXXXX}
darwin:
  <<: *all
  # SUBFORK_CONFIG_FILE: /usr/local/etc/subfork/subfork.yml
linux:
  <<: *all
  # SUBFORK_CONFIG_FILE: /etc/subfork/subfork.yml
windows:
  <<: *all
  # SUBFORK_CONFIG_FILE: C:/ProgramData/subfork/subfork.yml
