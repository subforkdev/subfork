#!/usr/bin/env envstack
include: []
all: &all
  SUBFORK_DEBUG: false
  # SUBFORK_DOMAIN: test.fork.io
  SUBFORK_ACCESS_KEY: ${SUBFORK_ACCESS_KEY:=XXXXXXXXXXXXXXXX}
  SUBFORK_SECRET_KEY: ${SUBFORK_SECRET_KEY:=XXXXXXXXXXXXXXXX}
  # SUBFORK_CONFIG_FILE: {CONFIG_ROOT}/subfork.yml
darwin:
  <<: *all
  CONFIG_ROOT: /usr/local/etc/subfork
linux:
  <<: *all
  CONFIG_ROOT: /etc/subfork
windows:
  <<: *all
  CONFIG_ROOT: C:/ProgramData/subfork
