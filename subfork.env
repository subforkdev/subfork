#!/usr/bin/env envstack
include: []
all: &all
  SUBFORK_DEBUG: ${SUBFORK_DEBUG:=0}
  SUBFORK_ACCESS_KEY: ${SUBFORK_ACCESS_KEY}
  SUBFORK_SECRET_KEY: ${SUBFORK_SECRET_KEY}
darwin:
  <<: *all
  ROOT: ${ROOT:=/usr/local/etc/subfork}
linux:
  <<: *all
  ROOT: ${ROOT:=/etc/subfork}
windows:
  <<: *all
  ROOT: ${ROOT:=C:/ProgramData/subfork}
