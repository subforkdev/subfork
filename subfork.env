#!/usr/bin/env envstack
include: [default]
all: &all
  SUBFORK_DEBUG: ${SUBFORK_DEBUG:=0}
  SUBFORK_DOMAIN: ${SUBFORK_DOMAIN}
  SUBFORK_ACCESS_KEY: ${SUBFORK_ACCESS_KEY}
  SUBFORK_SECRET_KEY: ${SUBFORK_SECRET_KEY}
darwin:
  <<: *all
  DEPLOY_ROOT: /usr/local/etc/subfork
linux:
  <<: *all
  DEPLOY_ROOT: /etc/subfork
windows:
  <<: *all
  DEPLOY_ROOT: C:/ProgramData/subfork
